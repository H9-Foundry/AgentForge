  "ignore": [
    "@agentops/registry-client",
    "@agentops/agent-code-review",
    "@agentops/agent-context-collector",
    "@agentops/agent-security-audit",
    "@agentops/agent-test-generation",
    "@agentops/adapters-filesystem",
    "@agentops/adapters-git",
    "@agentops/adapters-github",
    "@agentops/adapters-shell"
  ]
}
