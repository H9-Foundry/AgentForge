{
  "version": 1,
  "name": "context-collector",
  "displayName": "Context Collector",
  "category": "context",
  "runtime": {
    "minVersion": "0.1.0",
    "kind": "deterministic"
  },
  "permissions": {
    "model": false,
    "network": false,
    "tools": [],
    "readPaths": ["**/*"],
    "writePaths": []
  },
  "inputs": ["repo", "changes", "context"],
  "outputs": ["summary", "metadata"],
  "contextPolicy": {
    "sections": ["repo", "changes", "context"],
    "minimalContext": true
  },
  "catalog": {
    "domain": "foundation",
    "supportLevel": "official",
    "maturity": "mvp",
    "trustScope": "official-core-only"
  },
  "trust": {
    "tier": "core",
    "source": "official",
    "reviewed": true
  }
}
