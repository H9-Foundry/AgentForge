{
  "version": 1,
  "name": "security-audit",
  "displayName": "Security Audit",
  "category": "security",
  "runtime": {
    "minVersion": "0.1.0",
    "kind": "reasoning"
  },
  "permissions": {
    "model": true,
    "network": false,
    "tools": ["git.diff-summary", "filesystem.read-file"],
    "readPaths": ["**/*"],
    "writePaths": []
  },
  "inputs": ["repo", "changes", "policy"],
  "outputs": ["findings", "blockedActionFlags"],
  "contextPolicy": {
    "sections": ["repo", "changes", "policy"],
    "minimalContext": true
  },
  "trust": {
    "tier": "core",
    "source": "official",
    "reviewed": true
  }
}
