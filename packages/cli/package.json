{
  "name": "@agentops/cli",
  "version": "0.2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agentops": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentops/audit": "workspace:*",
    "@agentops/context-engine": "workspace:*",
    "@agentops/policy-engine": "workspace:*",
    "@agentops/runtime": "workspace:*",
    "@agentops/schemas": "workspace:*",
    "@agentops/sdk": "workspace:*",
    "@agentops/shared-types": "workspace:*",
    "commander": "^13.1.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.2"
  }
}
