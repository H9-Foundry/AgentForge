{
  "name": "@h9-foundry/agentforge-visualizer",
  "version": "0.12.5",
  "private": true,
  "description": "Local web app runtime for the AgentForge visualizer CLI surface.",
  "license": "MIT",
  "author": "H9 Foundry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H9-Foundry/AgentForge.git",
    "directory": "packages/visualizer"
  },
  "homepage": "https://github.com/H9-Foundry/AgentForge/tree/main/packages/visualizer#readme",
  "bugs": {
    "url": "https://github.com/H9-Foundry/AgentForge/issues"
  },
  "keywords": [
    "agentforge",
    "visualizer",
    "benchmarking",
    "outcomes",
    "developer-tools"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@h9-foundry/agentforge-schemas": "workspace:*",
    "@h9-foundry/agentforge-shared-types": "workspace:*"
  }
}
