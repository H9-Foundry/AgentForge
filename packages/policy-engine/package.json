{
  "name": "@h9-foundry/agentforge-policy-engine",
  "version": "0.2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@h9-foundry/agentforge-schemas": "workspace:*",
    "@h9-foundry/agentforge-shared-types": "workspace:*",
    "js-yaml": "^4.1.0",
    "picomatch": "^4.0.2"
  }
}
