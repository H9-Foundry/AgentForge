{
  "name": "@agentops/runtime",
  "version": "0.2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentops/audit": "workspace:*",
    "@agentops/policy-engine": "workspace:*",
    "@agentops/sdk": "workspace:*",
    "@agentops/schemas": "workspace:*",
    "@agentops/shared-types": "workspace:*"
  }
}
