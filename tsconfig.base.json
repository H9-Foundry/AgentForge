{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@agentops/schemas": ["packages/schemas/src/index.ts"],
      "@agentops/shared-types": ["packages/shared-types/src/index.ts"],
      "@agentops/sdk": ["packages/sdk/src/index.ts"],
      "@agentops/context-engine": ["packages/context-engine/src/index.ts"],
      "@agentops/policy-engine": ["packages/policy-engine/src/index.ts"],
      "@agentops/audit": ["packages/audit/src/index.ts"],
      "@agentops/runtime": ["packages/runtime/src/index.ts"],
      "@agentops/registry-client": ["packages/registry-client/src/index.ts"],
      "@agentops/cli": ["packages/cli/src/index.ts"],
      "@agentops/agent-context-collector": ["agents/context-collector/src/index.ts"],
      "@agentops/agent-code-review": ["agents/code-review/src/index.ts"],
      "@agentops/agent-security-audit": ["agents/security-audit/src/index.ts"],
      "@agentops/agent-test-generation": ["agents/test-generation/src/index.ts"],
      "@agentops/adapters-filesystem": ["adapters/filesystem/src/index.ts"],
      "@agentops/adapters-git": ["adapters/git/src/index.ts"],
      "@agentops/adapters-shell": ["adapters/shell/src/index.ts"],
      "@agentops/adapters-github": ["adapters/github/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  }
}
